{
  "name": "task-buddy",
  "version": "1.0.0",
  "description": "Discord Task Management Bot for managing task batches, verified Reddit accounts, private task tickets, proof submission, and member statistics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate --schema=src/database/prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate --schema=src/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=src/database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/database/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=src/database/prisma/schema.prisma",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    },
  "keywords": [
    "discord",
    "bot",
    "task",
    "management",
    "reddit",
    "verification"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "@types/express": "^5.0.6",
    "discord-api-types": "^0.37.87",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1",
    "express": "^5.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "prisma": "^5.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "schema": "src/database/prisma/schema.prisma"
  }
}
