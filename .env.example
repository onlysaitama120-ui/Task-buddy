# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
OWNER_USER_ID=your_discord_user_id_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/task_buddy?schema=public

# Reddit Verification Requirements (defaults, can be overridden per-server via /config)
MIN_REDDIT_KARMA=100
MIN_REDDIT_ACCOUNT_AGE_DAYS=30

# Task Settings
TASK_DEADLINE_MINUTES=30